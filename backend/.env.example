# Optional: enables GPT-based highlight ranking. Without it, a local heuristic is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# faster-whisper model: tiny, base, small, medium, large-v3 (bigger = slower, more accurate)
WHISPER_MODEL=base

MAX_UPLOAD_MB=2048
MAX_SOURCE_SECONDS=43200
# Add your Vercel frontend's URL here in production (comma-separated if more than one).
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,https://your-app.vercel.app
