{
  "name": "cliplabs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "setup:backend": "cd backend && python3.12 -m venv .venv && .venv/bin/pip install --index-url https://pypi.org/simple -r requirements.txt",
    "backend": "cd backend && DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "test:backend": "cd backend && DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib .venv/bin/python -m pytest -q"
  },
  "dependencies": { "@vitejs/plugin-react": "^5.0.4", "vite": "^7.2.2", "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {},
  "engines": { "node": "22.x" }
}
